# ---------------------------------------------------------------------------
# One Talk env — copy to .env.development / .env.production.
# Only VITE_* vars reach the client. Read them ONLY through src/config/env.ts.
# ---------------------------------------------------------------------------

# REST API origin. Endpoint paths from lib/endpoints.ts are appended to this.
VITE_APP_API_URL=http://localhost:4000

# Dev-only reverse-proxy target. When set, requests go same-origin via /api
# and vite.config.ts forwards them (websocket upgrade included).
VITE_APP_API_TARGET=

# socket.io origin — FALLBACK ONLY. The real origin and path come from
# GET /config (realtime_url / realtime_path); this is used only when that read
# fails. Leave empty to reuse the API origin / dev proxy.
VITE_APP_SOCKET_URL=

# Secret used to derive the key that encrypts persisted client storage.
VITE_APP_ENCRYPT_KEY=xpertone-talk-storage-key

# Cookie namespace. MUST differ from the XpertOne admin app so the two
# sessions never overwrite each other when served from the same origin.
VITE_APP_COOKIE_PREFIX=xtk
